# ============================================
# KwiqBuy — Phase 1 additions (append to .env)
# ============================================

# Logging
LOG_LEVEL=INFO
LOG_JSON=False   # pretty console in dev, set True in prod

# Sentry (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# CORS — enforce strict origins in production
ENFORCE_CORS_IN_PRODUCTION=True

# Admin IP allowlist — enable to restrict admin panel to specific IPs
ADMIN_IP_ALLOWLIST_ENABLED=False

# Platform cut from delivery fees (%)
PLATFORM_DELIVERY_CUT_PCT=20.0
