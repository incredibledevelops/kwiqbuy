# ============================================
# KwiqBuy — Backend Environment
# ============================================

APP_NAME="KwiqBuy API"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000

HOST=0.0.0.0
PORT=8000

# ---------- MongoDB (replica set required for transactions) ----------
MONGODB_URL=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB_NAME=kwiqbuy
MONGODB_TRANSACTIONS_ENABLED=True

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# ---------- JWT ----------
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CUSTOMER_TOKEN_EXPIRE_DAYS=30
CUSTOMER_REFRESH_EXPIRE_DAYS=90
CUSTOMER_OTP_EXPIRE_MINUTES=10

# ---------- Paystack ----------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:3000/order/callback

# ---------- Paystack Transfers (vendor payouts) ----------
PAYSTACK_TRANSFER_ENABLED=False
PAYSTACK_TRANSFER_TYPE=ghipss
PAYOUT_SCHEDULE=manual

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ---------- Uploads ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
EXIF_STRIP_ON_UPLOAD=True

# ---------- Business ----------
DEFAULT_DELIVERY_FEE=15.00
CURRENCY=GHS
FREE_DELIVERY_THRESHOLD=100.0

# ---------- Marketplace ----------
DEFAULT_PLATFORM_COMMISSION_PCT=15.0
MIN_VENDOR_PAYOUT_GHS=50.0

# ---------- Rider ----------
RIDER_FEE_MODEL=flat
RIDER_FLAT_FEE_GHS=8.0
RIDER_PCT_OF_DELIVERY_FEE=100.0

# ---------- Email (Resend) ----------
RESEND_API_KEY=
MAIL_FROM=KwiqBuy <onboarding@resend.dev>
MAIL_FROM_NAME=KwiqBuy

# ---------- SMS (Arkesel) ----------
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=KwiqBuy
ARKESEL_BASE_URL=https://sms.arkesel.com/api/v2

# ---------- Loyalty ----------
LOYALTY_POINTS_PER_CEDI=1
LOYALTY_POINTS_TO_CEDI=0.01
LOYALTY_MIN_REDEEM=100

# ---------- Rate limits ----------
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_OTP=3/minute
RATE_LIMIT_ORDER=20/minute
RATE_LIMIT_VENDOR_APPLICATION=3/hour
RATE_LIMIT_VENDOR_PRODUCT_WRITE=60/hour

# ---------- Support ----------
SUPPORT_PHONE=0534634845
SUPPORT_WHATSAPP=233534634845