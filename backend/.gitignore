# ---------- Environment & Secrets ----------
.env
.env.local
.env.production
.env.staging
*.pem
*.key
secrets/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------- Virtual Environment ----------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.python-version

# ---------- Testing ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
coverage.xml
*.cover
.cache

# ---------- Type checking / linting ----------
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/

# ---------- Uploads ----------
uploads/*
!uploads/.gitkeep
!uploads/menu/.gitkeep
!uploads/categories/.gitkeep
!uploads/builder/.gitkeep
!uploads/reviews/.gitkeep

# ---------- Logs ----------
*.log
logs/
uvicorn.log

# ---------- Backup files ----------
*.bak
*.tmp
*.orig
*.rej