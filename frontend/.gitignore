# ============================================
# Mr. Robert's Fries — Frontend .gitignore
# ============================================

# ---------- Environment & Secrets ----------
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.vercel

# ---------- Dependencies ----------
/node_modules
/.pnp
.pnp.js
.pnp.cjs

# ---------- Next.js ----------
/.next/
/out/
.next
next-env.d.ts
.swc/

# ---------- Production builds ----------
/build
/dist
*.tsbuildinfo

# ---------- Vercel ----------
.vercel/

# ---------- Misc ----------
.DS_Store
*.pem

# ---------- Debug logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ---------- Local env files ----------
.env*.local

# ---------- Testing ----------
/coverage
.nyc_output/

# ---------- Cache ----------
.cache/
.turbo/
.eslintcache

# ---------- Editor ----------
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json