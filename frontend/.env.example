# ============================================
# Mr. Robert's Fries — Frontend Environment
# ============================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` — only commit `.env.example`.
#
# IMPORTANT: Any variable prefixed with NEXT_PUBLIC_ is exposed
# to the browser. Never put secrets in NEXT_PUBLIC_ variables.

# ---------- API ----------
# Local:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Production:
# NEXT_PUBLIC_API_URL=https://api.mrfries.com

# ---------- Site URL (for SEO, OpenGraph, sitemaps) ----------
# Local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production:
# NEXT_PUBLIC_SITE_URL=https://mrfries.com

# ---------- Paystack (public key only — safe for browser) ----------
# Test key:
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Live key (for production):
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Analytics (optional) ----------
# Google Analytics 4:
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# PostHog:
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# ---------- Google Search Console (optional) ----------
# Paste the content value from your verification meta tag:
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=